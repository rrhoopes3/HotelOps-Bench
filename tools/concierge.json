       "book_service"
      ]
     },
     "amount": {
      "type": "number"
     },
     "answer": {
      "type": "string",
      "enum": [
       "yes",
       "no"
      ]
     }
    },
    "additionalProperties": false,
    "required": [
     "action",
     "answer"
    ]
   }
  }
 },
